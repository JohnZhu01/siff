					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem"
				},
				{
					"slug": "x-large",
					"name": "Extra Large",
					"size": "2rem"
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|custom-background",
			"text": "var:preset|color|custom-text"
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var:preset|color|custom-deep-blue"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50"
					}
				}
			},
			"core/button": {
				"border": {
					"radius": {
						"bottomLeft": "4px",
						"bottomRight": "4px",
						"topLeft": "4px",
						"topRight": "4px"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"top": "var(--wp--preset--spacing--30)"
					}
				},
				
				"typography": {
					"fontSize": "1rem"
				}
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|custom-accents"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|montserrat",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"link": {
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|custom-accents",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				},
				"color": {
					"text": "var:preset|color|custom-accents"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|custom-text"
					}
				}
			},
			"button": {
				":hover": {
					"color": {
						"background": "var:preset|color|custom-text",
						"text": "var:preset|color|custom-background"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|custom-accents",
						"offset": "3px",
						"style": "solid",
						"width": "2px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--custom-accents)",
					"text": "var(--wp--preset--color--custom-background)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "1.75rem",
					"fontStyle": "normal",
					"fontWeight": "600"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.25rem + 2vw, 2.5rem)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.5rem, 1.25rem + 1vw, 2rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.5rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1rem"
				}
			}
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"bottom": "0px",
				"left": "0px",
				"right": "0px",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--merriweather-sans)",
			"fontSize": "1.5rem",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.5"
		}
	},
	"templateParts": [
		{
			"area": "uncategorized",
			"name": "ticket-actions",
			"title": "Buy Tickets and Cart"
		},
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}