	"styles": {
		"blocks": {
			"core/button": {
				"border": {
					"radius": {
						"bottomLeft": "4px",
						"bottomRight": "4px",
						"topLeft": "4px",
						"topRight": "4px"
					}
				},
				"spacing": {
					"padding": {
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--40)",
						"right": "var(--wp--preset--spacing--40)",
						"top": "var(--wp--preset--spacing--30)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "0",
						"top": "0"
					},
					"padding": {
						"bottom": "var(--wp--preset--spacing--50)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)",
						"top": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"textIndent": "1px"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--custom-deep-blue)"
				},
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--50)",
						"top": "var(--wp--preset--spacing--50)"
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--custom-background)",
			"text": "var(--wp--preset--color--custom-text)"
		},
		"elements": {
			"button": {
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--custom-accents)",
						"offset": "0.1875rem",
						"style": "solid",
						"width": "0.125rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--custom-text)",
						"text": "var(--wp--preset--color--custom-background)"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--custom-accents)",
					"text": "var(--wp--preset--color--custom-background)"
				},
				"spacing": {
					"padding": {
						"bottom": "0.75em",
						"left": "1.25em",
						"right": "1.25em",
						"top": "0.75em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "1rem",
					"fontStyle": "normal",
					"fontWeight": "600",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontSize": "clamp(2rem, 1.5rem + 2vw, 3rem)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.75rem, 1.25rem + 2vw, 2.5rem)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "clamp(1.5rem, 1.25rem + 1vw, 2rem)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.5rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1rem"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-text)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"link": {
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--custom-accents)",
						"offset": "0.1875rem",
						"style": "solid",
						"width": "0.125rem"
					}
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--custom-text)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--custom-accents)"
				},
				"typography": {
					"textDecoration": "underline"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"bottom": "30px",
				"left": "30px",
				"right": "30px",
				"top": "30px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--merriweather-sans)",
			"fontSize": "1.125rem",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.55"
		}
	},
	"templateParts": [
		{
			"area": "uncategorized",
			"name": "ticket-actions",
			"title": "Buy Tickets and Cart"
		},
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}